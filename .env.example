# Used by `npm run dev:api`. docker compose sets the same variables itself.
DATABASE_URL=postgres://ticketwave:ticketwave@localhost:5432/ticketwave
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
HOLD_TTL_SECONDS=120
BCRYPT_ROUNDS=10
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:4000
SEED_ON_BOOT=true
SWEEPER_INTERVAL_MS=15000
